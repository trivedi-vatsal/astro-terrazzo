  "description": "A bento-grid portfolio and blog theme for Astro: work timeline, experiments, journal with series and Mermaid, generated share images, light and dark mode.",
  "author": {
    "name": "trivedi-vatsal",
    "url": "https://github.com/trivedi-vatsal"
  },
  "license": "MIT",
  "homepage": "https://vatsal.xyz/astro-terrazzo/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trivedi-vatsal/astro-terrazzo.git"
  },
  "bugs": "https://github.com/trivedi-vatsal/astro-terrazzo/issues",
  "keywords": [
    "astro",
    "withastro",
    "astro-theme",
    "astro-template",
    "portfolio",
    "blog",
    "bento",
    "tailwind"
  ],
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "astro dev",
