    "astro": "^7.4.13",
    "mermaid": "^11.17.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^22.20.5",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "packageManager": "pnpm@11.15.1"
