---
import { getCollection, render, type CollectionEntry } from 'astro:content'
import {
  Mermaid,
  SeriesNav,
  ShareMenu,
  TocInline,
  TocMinimap,
  buildSeriesCatalog,
  formatReadingTime,
  getReadingTime,
  getSeriesForPost,
  isListedPost,
  tagHref,
  toBlogPostSummary,
} from '@terrazzo/blog'
import { blogPostingJsonLd, ogImageUrl } from '@terrazzo/seo'
import PageLayout from './PageLayout.astro'
import { PAGES, SITE } from '../config.ts'

interface Props {
  post: CollectionEntry<'blog'>
}

const { post } = Astro.props
const { Content, headings } = await render(post)
const site = Astro.site!
const author = post.data.author ?? SITE.author
const modified = post.data.updatedDate ?? post.data.pubDate
const url = new URL(`/blog/${post.id}/`, site).href
const image = post.data.heroImage
  ? new URL(post.data.heroImage, site).href
  : ogImageUrl(site, `blog/${post.id}`)
const series = post.data.series
  ? getSeriesForPost(
      toBlogPostSummary(post),
      buildSeriesCatalog(
        (await getCollection('blog', isListedPost)).map(toBlogPostSummary),
      ),
    )
  : undefined
const toc = headings
  .filter((heading) => heading.depth >= 2 && heading.depth <= 4)
  .map((heading) => ({
    title: heading.text,
    url: `#${heading.slug}`,
    depth: heading.depth,
  }))
const longDate = (date: Date) =>
  date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC',
  })
---

<PageLayout
  title={post.data.title}
  description={post.data.description}
  image={image}
  type="article"
  publishedTime={post.data.pubDate}
  modifiedTime={modified}
  author={author}
  jsonLd={[
    blogPostingJsonLd({
      site,
      title: post.data.title,
      description: post.data.description,
      url,
      datePublished: post.data.pubDate,
      dateModified: modified,
      author,
      image,
    }),
  ]}
>
  <Fragment slot="header">
    <nav aria-label="Breadcrumb" class="text-muted-foreground mb-4 text-sm">
      <ol class="flex flex-wrap items-center gap-2">
        <li>
          <a href="/" class="hover:text-primary transition-colors">
            Home
          </a>
        </li>
        <li aria-hidden="true">›</li>
        <li>
          <a href="/blog/" class="hover:text-primary transition-colors">
            {PAGES.blog.title}
          </a>
        </li>
        <li aria-hidden="true">›</li>
        <li class="text-foreground" aria-current="page">
          {post.data.title}
        </li>
      </ol>
    </nav>
    <div class="flex items-start justify-between gap-4 border-b pb-2">
      <h1 class="scroll-m-20 text-3xl font-semibold tracking-tight">
        {post.data.title}
      </h1>
      <div class="shrink-0 pt-1">
        <ShareMenu title={post.data.title} url={url} />
      </div>
    </div>
    <div class="text-muted-foreground mt-4 flex flex-wrap items-center gap-3 text-sm">
      <span>{author}</span>
      <span aria-hidden="true">·</span>
      <time datetime={post.data.pubDate.toISOString()}>
        {longDate(post.data.pubDate)}
      </time>
      <span aria-hidden="true">·</span>
      <span>{formatReadingTime(getReadingTime(post.body))}</span>
      {post.data.updatedDate && (
        <>
          <span aria-hidden="true">·</span>
          <span>Updated {longDate(post.data.updatedDate)}</span>
        </>
      )}
    </div>
    {post.data.tags.length > 0 && (
      <div class="mt-3 flex flex-wrap gap-2">
        {post.data.tags.map((tag) => (
          <a
            href={tagHref(tag)}
            class="bg-secondary text-secondary-foreground hover:bg-primary/10 hover:text-primary rounded-md px-2 py-0.5 text-xs transition-colors"
          >
            {tag}
          </a>
        ))}
      </div>
    )}
    {series && <SeriesNav series={series} currentId={post.id} />}
  </Fragment>

  {toc.length > 0 && (
    <div class="mb-8 lg:hidden">
      <TocInline items={toc} />
    </div>
  )}
  <article class="prose max-w-none">
    <Content />
  </article>
  <Mermaid />
  {series && (
    <SeriesNav series={series} currentId={post.id} placement="footer" />
  )}
  {toc.length > 0 && (
    <div class="pointer-events-none fixed inset-y-0 right-3 z-40 hidden items-center sm:right-6 lg:flex xl:right-10">
      <div class="pointer-events-auto">
        <TocMinimap items={toc} />
      </div>
    </div>
  )}
</PageLayout>
