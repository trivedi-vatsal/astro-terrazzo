---
import { withBase } from '@terrazzo/ui'
import { getCollection } from 'astro:content'
import {
  BlogExplorer,
  getAllTags,
  isListedPost,
  slugifyTag,
  toBlogPostSummary,
} from '@terrazzo/blog'
import PageLayout from '../../../layouts/PageLayout.astro'
import { PAGES } from '../../../config.ts'

export async function getStaticPaths() {
  const posts = (await getCollection('blog', isListedPost))
    .map(toBlogPostSummary)
    .sort((a, b) => b.pubDate.localeCompare(a.pubDate))

  return getAllTags(posts).map(({ tag, slug }) => ({
    params: { tag: slug },
    props: {
      tag,
      slug,
      posts: posts.filter((post) =>
        post.tags.some((t) => slugifyTag(t) === slug),
      ),
    },
  }))
}

const { tag, slug, posts } = Astro.props
const description = `Posts about ${tag}`
---

<PageLayout title={tag} description={description}>
  <Fragment slot="header">
    <nav aria-label="Breadcrumb" class="text-muted-foreground mb-4 text-sm">
      <ol class="flex flex-wrap items-center gap-2">
        <li>
          <a href={withBase('/')} class="hover:text-primary transition-colors">
            Home
          </a>
        </li>
        <li aria-hidden="true">›</li>
        <li>
          <a
            href={withBase('/blog/')}
            class="hover:text-primary transition-colors"
          >
            {PAGES.blog.title}
          </a>
        </li>
        <li aria-hidden="true">›</li>
        <li class="text-foreground capitalize" aria-current="page">
          {tag}
        </li>
      </ol>
    </nav>
    <h1 class="scroll-m-20 border-b pb-2 text-3xl font-semibold tracking-tight capitalize">
      {tag}
    </h1>
    <p class="text-muted-foreground mt-4">{description}</p>
  </Fragment>

  <BlogExplorer posts={posts} initialTag={slug} />
</PageLayout>
