---
/** Folder cards that open to show tools on hover, focus or tap. */
import type { Folder } from './types.ts'

interface Props {
  folders: Folder[]
}

const { folders } = Astro.props
---

<section class="space-y-10" aria-label="Stack">
  <div class="flex flex-wrap items-baseline justify-between gap-3">
    <p class="font-mono text-[0.7rem] tracking-[0.2em] uppercase">
      Stack / {String(folders.length).padStart(2, '0')} folders
    </p>
    <p class="text-muted-foreground font-mono text-[0.65rem] tracking-[0.14em] uppercase">
      <span class="hidden sm:inline">Hover a folder to peek inside</span>
      <span class="sm:hidden">Tap a folder to peek inside</span>
    </p>
  </div>

  <stack-folders class="grid grid-cols-2 gap-5 sm:gap-6 md:grid-cols-4">
    {folders.map((folder, index) => (
      <button
        type="button"
        class="folder focus-visible:ring-foreground/40 relative flex w-full flex-col text-left outline-none focus-visible:ring-2 focus-visible:ring-offset-2"
        aria-pressed="false"
        aria-label={`Folder ${folder.id}: ${folder.category}, ${folder.tools.join(', ')}`}
        style={`transition-delay: ${index * 30}ms`}
      >
        <span class="tab relative ml-3 h-3.5 w-[42%] rounded-t-[3px]" />
        <span class="body relative -mt-px flex min-h-[11.5rem] flex-col justify-between overflow-hidden rounded-sm rounded-tl-none px-3.5 pt-4 pb-3.5 sm:min-h-[13rem]">
          <span class="flex items-start justify-between gap-2">
            <span class="font-mono text-[0.65rem] tracking-[0.18em] uppercase opacity-55">
              {folder.id}
            </span>
            <span class="open-label font-mono text-[0.6rem] tracking-wide uppercase">
              open
            </span>
          </span>
          <span class="space-y-3">
            <span class="tools block font-mono text-[0.7rem] leading-relaxed tracking-wide">
              {folder.tools.join(' · ')}
              <span class="opacity-50"> · {folder.category}</span>
            </span>
            <span class="block text-[1.35rem] leading-none font-semibold tracking-tight capitalize sm:text-2xl">
              {folder.category}
            </span>
          </span>
        </span>
      </button>
    ))}
  </stack-folders>
</section>

<script>
  // Tapping keeps a folder open on touch screens; hover and focus are CSS.
  class StackFolders extends HTMLElement {
    connectedCallback() {
      const folders = [...this.querySelectorAll('button')]
      const press = (target?: Element) =>
        folders.forEach((f) =>
          f.setAttribute('aria-pressed', String(f === target)),
        )
      for (const folder of folders) {
        folder.addEventListener('click', () =>
          press(
            folder.getAttribute('aria-pressed') === 'true' ? undefined : folder,
          ),
        )
        folder.addEventListener('mouseleave', () => press())
        folder.addEventListener('blur', () => press())
      }
    }
  }
  customElements.define('stack-folders', StackFolders)
</script>

<style>
  .tab {
    background: #d6c4a3;
    transition: background-color 0.3s;
  }
  .body {
    background: #f3e6cc;
    color: #3a3126;
    transition: all 0.3s;
  }
  .open-label {
    opacity: 0;
    transition: opacity 0.3s;
  }
  .tools {
    pointer-events: none;
    opacity: 0;
    transform: translateY(0.75rem);
    transition: all 0.3s;
  }
  :global(.dark) .tab {
    background: #6b5a42;
  }
  :global(.dark) .body {
    background: #7a664c;
    color: #f5ecdc;
  }

  .folder:is(:hover, :focus-visible, [aria-pressed='true']) .tab {
    background: #c4a574;
  }
  .folder:is(:hover, :focus-visible, [aria-pressed='true']) .body {
    transform: translateY(-6px);
    background: #e8d7b5;
    color: #2a2218;
    box-shadow: 0 18px 40px -28px rgba(0, 0, 0, 0.55);
  }
  .folder:is(:hover, :focus-visible, [aria-pressed='true']) .open-label {
    opacity: 0.7;
  }
  .folder:is(:hover, :focus-visible, [aria-pressed='true']) .tools {
    opacity: 0.9;
    transform: none;
  }
  :global(.dark)
    .folder:is(:hover, :focus-visible, [aria-pressed='true'])
    .tab {
    background: #8a7350;
  }
  :global(.dark)
    .folder:is(:hover, :focus-visible, [aria-pressed='true'])
    .body {
    background: #9a8160;
    color: #1a140e;
  }

  @media (prefers-reduced-motion: reduce) {
    .body,
    .tools {
      transition: none;
    }
  }
</style>
