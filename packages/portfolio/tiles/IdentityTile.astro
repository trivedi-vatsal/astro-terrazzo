---
import { withBase } from '@terrazzo/ui'
import BentoTile from './BentoTile.astro'
import type { Identity } from '../types.ts'

type Props = Identity

const { eyebrow, name, statement, primary, secondary, location, meta } =
  Astro.props
const escape = (value: string) =>
  value.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`)
// One word per line, then an accent dot. Built as a string so no whitespace
// sneaks in between the last word and the dot.
const nameHtml = `${name.split(' ').map(escape).join('<br />')}<span>.</span>`
---

<BentoTile
  id="identity"
  tile="identity"
  class="identity-tile order-1 col-span-1 sm:col-span-2 lg:col-span-8"
  as="section"
  label="Introduction"
>
  <div class="identity-copy">
    <p class="bento-label bento-wake bento-wake-label">{eyebrow}</p>
    <h1 class="bento-wake bento-wake-title" set:html={nameHtml} />
    <p class="identity-description">{statement}</p>
    <div class="identity-actions">
      <a
        class="work-link bento-wake bento-wake-up"
        style="--wake-delay: 40ms"
        href={withBase(primary.href)}
      >
        {primary.label}
      </a>
      <a
        class="about-link bento-wake bento-wake-x"
        style="--wake-delay: 80ms"
        href={withBase(secondary.href)}
      >
        {secondary.label} <span aria-hidden="true">→</span>
      </a>
    </div>
    <a
      class="identity-location bento-wake bento-wake-fade"
      style="--wake-delay: 120ms"
      href={withBase(location.href)}
    >
      {location.label}
    </a>
  </div>
  <dl class="identity-meta">
    {meta.map((item, i) => (
      <div class="bento-wake bento-wake-up" style={`--wake-delay: ${i * 50}ms`}>
        <dt>{item.label}</dt>
        <dd>{item.value}</dd>
      </div>
    ))}
  </dl>
</BentoTile>

<style>
  :global(.identity-tile) {
    display: grid;
    grid-template-columns: 1fr;
    background: hsl(var(--card));
  }
  .identity-copy {
    padding: 34px 34px 28px;
    min-width: 0;
  }
  h1 {
    font-size: clamp(48px, 5.5vw, 72px);
    line-height: 1.05;
    letter-spacing: -0.065em;
    font-weight: 600;
    margin: 20px 0 16px;
    text-wrap: balance;
  }
  .bento-wake-title {
    letter-spacing: -0.065em;
  }
  :global(.identity-tile:hover) .bento-wake-title {
    letter-spacing: -0.075em;
    color: inherit;
  }
  :global(.identity-tile:hover) .bento-wake-title :global(span) {
    color: hsl(var(--primary));
  }
  .identity-description {
    color: hsl(var(--muted-foreground));
    font-size: 1rem;
    line-height: 1.7;
    max-width: 42ch;
  }
  .identity-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 22px;
    margin-top: 24px;
    font-size: 0.8125rem;
  }
  .work-link {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    border-radius: 0.5rem;
    background: hsl(var(--foreground));
    color: hsl(var(--background));
    transition:
      background-color 0.2s ease,
      color 0.2s ease,
      transform 0.2s ease;
  }
  .work-link:hover {
    background: hsl(var(--primary));
    color: hsl(var(--primary-foreground));
  }
  .work-link:active,
  .about-link:active {
    transform: scale(0.98);
  }
  .about-link {
    display: inline-flex;
    align-items: center;
    transition:
      color 0.2s ease,
      transform 0.2s ease;
  }
  .about-link:hover {
    color: hsl(var(--primary));
  }
  .about-link span {
    margin-left: 8px;
  }
  .identity-location {
    display: inline-block;
    margin-top: 18px;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    color: hsl(var(--muted-foreground));
    text-underline-offset: 3px;
    transition: color 0.2s ease;
  }
  .identity-location:hover {
    color: hsl(var(--primary));
    text-decoration: underline;
  }
  .identity-meta {
    display: flex;
    gap: 38px;
    border-top: 1px solid hsl(var(--border));
    padding: 20px 34px;
  }
  dt {
    color: hsl(var(--muted-foreground));
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.7rem;
  }
  dd {
    font-size: 0.875rem;
    font-weight: 500;
    margin-top: 5px;
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
  }
  a:focus-visible {
    outline: 2px solid hsl(var(--primary));
    outline-offset: 4px;
  }
  @media (max-width: 700px) {
    .identity-copy {
      padding: 26px;
    }
    h1 {
      font-size: 2.75rem;
    }
    .identity-description {
      max-width: none;
    }
    .identity-meta {
      padding: 20px 26px;
      gap: 24px;
    }
  }
</style>
