---
/**
 * Title, description, canonical, Open Graph, Twitter and JSON-LD tags.
 * Site-specific links (favicons, manifest, feeds) belong in your layout.
 */
import { OG_HEIGHT, OG_WIDTH, ogImageUrl, ogPathFor } from './og.ts'

interface Props {
  /** Full page title, already formatted. */
  title: string
  description: string
  siteName: string
  /** Absolute URL of the share image; defaults to the generated /og/ image. */
  image?: string | undefined
  /** Keep the page out of search results (e.g. 404). */
  noindex?: boolean
  type?: 'website' | 'article'
  publishedTime?: Date | undefined
  modifiedTime?: Date | undefined
  author?: string | undefined
  /** JSON-LD objects, one <script> each. */
  jsonLd?: object[]
}

const {
  title,
  description,
  siteName,
  image: customImage,
  noindex = false,
  type = 'website',
  publishedTime,
  modifiedTime,
  author,
  jsonLd = [],
} = Astro.props

const canonical = new URL(Astro.url.pathname, Astro.site)
const article = type === 'article'
const image =
  customImage ?? ogImageUrl(Astro.site!, ogPathFor(Astro.url.pathname))
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="robots" content={noindex ? 'noindex' : 'index, follow'} />
<meta name="generator" content={Astro.generator} />
<title>{title}</title>
<meta name="description" content={description} />
{!noindex && <link rel="canonical" href={canonical} />}

<meta property="og:type" content={type} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={image} />
{!customImage && (
  <>
    <meta property="og:image:width" content={String(OG_WIDTH)} />
    <meta property="og:image:height" content={String(OG_HEIGHT)} />
  </>
)}
<meta property="og:image:alt" content={title} />
<meta property="og:site_name" content={siteName} />
{article && publishedTime && (
  <meta
    property="article:published_time"
    content={publishedTime.toISOString()}
  />
)}
{article && modifiedTime && (
  <meta property="article:modified_time" content={modifiedTime.toISOString()} />
)}
{article && author && <meta property="article:author" content={author} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />

{jsonLd.map((data) => (
  <script
    type="application/ld+json"
    set:html={JSON.stringify(data).replaceAll('<', '\\u003c')}
  />
))}
