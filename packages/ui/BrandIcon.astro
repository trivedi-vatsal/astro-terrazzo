---
import { brands } from './brands.ts'

interface Props {
  name: string
  class?: string
  /** Use the brand's own color instead of currentColor. */
  colored?: boolean
}

const { name, class: className = 'size-full', colored = false } = Astro.props
const brand = brands[name]
---

{brand ? (
  <svg
    class={className}
    viewBox="0 0 24 24"
    fill={colored ? brand.hex : 'currentColor'}
    aria-hidden="true"
  >
    <path d={brand.path} />
  </svg>
) : (
  <span
    class:list={[
      'flex items-center justify-center font-mono text-sm font-semibold',
      className,
    ]}
    aria-hidden="true"
  >
    {name.trim().charAt(0).toUpperCase() || '?'}
  </span>
)}
